# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다 (앱이 pydantic-settings 로 직접 로드).

# LLM — 외부 API. 가명화된 입력만 보냅니다 (CLAUDE.md 불변식 2)
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=

# PostgreSQL — 체크포인터·실행 데이터
DATABASE_URL=postgresql://user:password@localhost:5432/task_spec
# 통합 테스트 전용 DB (DATABASE_URL 과 달라야 함)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/task_spec_test

# 온톨로지 산출물 (ontology-artifact 스킬)
ONTOLOGY_VERSION=dev
ONTOLOGY_ARTIFACT_DIR=data/ontology

# 지원자 원본·가명화본·결과 (git 밖)
DATA_DIR=data
