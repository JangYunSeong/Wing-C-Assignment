# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다 (앱이 pydantic-settings 로 직접 로드).

# LLM — 외부 API. 가명화된 입력만 보냅니다 (CLAUDE.md 불변식 2)
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=

# PostgreSQL — task_db 컨테이너 (docker/db/README.md)
# <pw> = data/secrets/task_db_password (TASK_DB_PASSWORD 로 컨테이너를 띄울 때 쓴 값)
DATABASE_URL=postgresql://task:<pw>@127.0.0.1:5434/task_db
# 통합 테스트 전용 DB (DATABASE_URL 과 달라야 함 — 같으면 conftest 가 거부)
TEST_DATABASE_URL=postgresql://task:<pw>@127.0.0.1:5434/task_db_test
# LangGraph 체크포인터: postgres(기본) | memory
CHECKPOINTER=postgres

# 온톨로지 산출물 (ontology-artifact 스킬)
# public.ontology_registry 의 버전 문자열 (load_pg 로 적재). dev = 가장 최근 적재 버전 — 개발용
ONTOLOGY_VERSION=dev
ONTOLOGY_ARTIFACT_DIR=data/ontology

# 지원자 원본·가명화본·결과 (git 밖)
DATA_DIR=data
# 과제 전달 묶음(응시용·채점용 이미지 tar, 평가 키트) — 비우면 <DATA_DIR>/images. 운영은 지원자 데이터와 다른 곳으로,
# API env(docker/api/.env)의 IMAGES_DIR 와 같은 호스트 경로 (docs/deploy.md 2-7)
# IMAGES_DIR=/srv/task-spec/images

# 자기소개서 사용 (기본 false — 검증할 주장은 이력서에서만, 2026-11-03 결정). false 면 업로드해도 저장·처리하지 않음
# USE_COVER_LETTERS=false

# 공통 과제 기능 개발형 기본값 규칙 (기본 false — draft_feature_task 평가 통과 뒤 켬). false 여도 승인자가 수정 요청에서 기능형을 지정할 수 있음
# FEATURE_TASK_DEFAULT=false

# API (선택 — 기본값 있음)
UPLOAD_MAX_BYTES=10485760
SSE_POLL_SECONDS=0.5
# 임시 화면 /ui/ (과제 명세 작업대). 인증이 없으니 운영은 nginx Basic 인증 뒤에서만
UI_ENABLED=true

# LLM 요청 1건 제한 시간(초, 선택)
# LLM_TIMEOUT_SECONDS=300

# 로깅 (선택) — 원문·키는 어느 수준에서도 남기지 않음
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # text | json

# 과제 생성 builder (#129, `python -m task_spec.builder`) — API 와 따로 도는 프로세스. 설정은 builder/settings.py 가 SSOT
# 비용 상한은 qwen 기준 (빌드 1건 평균 약 $0.05) — 모델을 바꾸면 같이 올린다
# BUILD_BUDGET_USD=0.5          # 작업당 — 넘으면 다음 단계로 가지 않고 실패 ("비용 상한")
# BUILD_DAILY_BUDGET_USD=5.0    # 하루 — 넘으면 큐에서 가져가지 않음
# BUILD_WORK_DIR=data/builder   # 작업 폴더 (생성 코드·검증 로그 — git 밖, 성공하면 지움)
# BUILD_LEASE_SECONDS=900       # heartbeat 가 없으면 죽은 작업으로 보는 시간
# BUILD_POLL_SECONDS=30
# BUILD_MAX_ATTEMPTS=2          # lease 가 지난 작업을 다시 대기열에 넣는 횟수
# BUILD_DESIGNS=1               # 참조 구현을 만들 허용 설계 수
# BUILD_KEEP_FAILED_WORK=true   # 실패한 빌드의 작업 폴더를 원인 확인용으로 남김
# BUILD_WORKER=<호스트-pid>     # lease 를 쥐는 이름
# 검증 격리 (#127): VERIFY_ISOLATION=container(기본)|host · VERIFY_CPUS=2 · VERIFY_MEMORY=4g
