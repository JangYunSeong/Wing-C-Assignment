# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다 (앱이 pydantic-settings 로 직접 로드).

# LLM — 외부 API. 가명화된 입력만 보냅니다 (CLAUDE.md 불변식 2)
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=

# PostgreSQL — task_db 컨테이너 (docker/db/README.md)
# <pw> = data/secrets/task_db_password (TASK_DB_PASSWORD 로 컨테이너를 띄울 때 쓴 값)
DATABASE_URL=postgresql://task:<pw>@127.0.0.1:5434/task_db
# 통합 테스트 전용 DB (DATABASE_URL 과 달라야 함 — 같으면 conftest 가 거부)
TEST_DATABASE_URL=postgresql://task:<pw>@127.0.0.1:5434/task_db_test
# LangGraph 체크포인터: postgres(기본) | memory
CHECKPOINTER=postgres

# 온톨로지 산출물 (ontology-artifact 스킬)
# public.ontology_registry 의 버전 문자열 (load_pg 로 적재). dev = 가장 최근 적재 버전 — 개발용
ONTOLOGY_VERSION=dev
ONTOLOGY_ARTIFACT_DIR=data/ontology

# 지원자 원본·가명화본·결과 (git 밖)
DATA_DIR=data

# 자기소개서 사용 (기본 false — 검증할 주장은 이력서에서만, 2026-11-03 결정). false 면 업로드해도 저장·처리하지 않음
# USE_COVER_LETTERS=false

# API (선택 — 기본값 있음)
UPLOAD_MAX_BYTES=10485760
SSE_POLL_SECONDS=0.5
# 임시 화면 /ui/ (과제 명세 작업대). 인증이 없으니 운영은 nginx Basic 인증 뒤에서만
UI_ENABLED=true

# LLM 요청 1건 제한 시간(초, 선택)
# LLM_TIMEOUT_SECONDS=300

# 로깅 (선택) — 원문·키는 어느 수준에서도 남기지 않음
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # text | json
