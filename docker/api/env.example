# 운영 서버용 env 파일 예시 → /etc/task-spec/env (chmod 600, 레포에 넣지 않음)
# 컨테이너 안 경로·기본값(PROMPTS_DIR, INCIDENTS_DIR, DATA_DIR=/data 등)은 이미지에 들어 있다.

# LLM — 외부 API (가명화된 입력만 보냄, CLAUDE.md 불변식 2)
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=

# PostgreSQL — 같은 podman 네트워크(task-net)의 task_db 컨테이너 이름으로 접속
DATABASE_URL=postgresql://task:<pw>@task_db:5432/task_db
# 운영 서버에서 pg 테스트를 돌릴 때만 (DATABASE_URL 과 달라야 함)
# TEST_DATABASE_URL=postgresql://task:<pw>@task_db:5432/task_db_test

# 온톨로지 버전 — 운영은 dev 별칭 대신 반드시 고정 (불변식 4). public.ontology_registry 의 version 값
ONTOLOGY_VERSION=v2026-10-30e@b69d00f+dirty

# 선택
# USE_COVER_LETTERS=false   # 자기소개서 사용 (기본 false — 이력서만)
# LLM_TIMEOUT_SECONDS=300   # LLM 요청 1건 제한 시간 (공통 과제 생성은 120초를 넘음)
# LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR — 원문·키는 어느 수준에서도 안 남음
# LOG_FORMAT=text           # text | json
# UPLOAD_MAX_BYTES=10485760
# SSE_POLL_SECONDS=0.5
