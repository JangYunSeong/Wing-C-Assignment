# 운영 서버용 env 파일 예시 → docker/api/.env (chmod 600, gitignore — 커밋하지 않음). run.sh 가 기본으로 읽는다
# 컨테이너 안 경로·기본값(PROMPTS_DIR, INCIDENTS_DIR, DATA_DIR=/data 등)은 이미지에 들어 있다.

# LLM — 외부 API (가명화된 입력만 보냄, CLAUDE.md 불변식 2)
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
# 돌연변이 생성기(gen_variant — 빌드 관문 ⑩·손 시범 유효성)는 Gemini — 없으면 그 호출이 실패한다
GEMINI_API_KEY=

# PostgreSQL — 같은 podman 네트워크(task-net)의 task_db 컨테이너 이름으로 접속
DATABASE_URL=postgresql://task:<pw>@task_db:5432/task_db
# 운영 서버에서 pg 테스트를 돌릴 때만 (DATABASE_URL 과 달라야 함)
# TEST_DATABASE_URL=postgresql://task:<pw>@task_db:5432/task_db_test

# 온톨로지 버전 — 운영은 dev 별칭 대신 반드시 고정 (불변식 4). public.ontology_registry 의 version 값
ONTOLOGY_VERSION=v2026-11-06f@60d5031+dirty

# 선택
# USE_COVER_LETTERS=false   # 자기소개서 사용 (기본 false — 이력서만)
# LLM_TIMEOUT_SECONDS=300   # LLM 요청 1건 제한 시간 (공통 과제 생성은 120초를 넘음)
# LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR — 원문·키는 어느 수준에서도 안 남음
# LOG_FORMAT=text           # text | json
# UPLOAD_MAX_BYTES=10485760
# SSE_POLL_SECONDS=0.5
# INTERVIEW_MAPPING_TTL_DAYS=30  # 사례 인터뷰 이름 대응표 — 승인·폐기 없이 이 기간 방치되면 폐기로 보고 지움
# INTERVIEW_DRAFT_TTL_HOURS=24   # 사례 인터뷰 화면의 원문 임시 저장 보관
# INTERVIEW_SWEEP_MINUTES=60     # 위 두 정리 주기

# 과제 전달 묶음 폴더 (호스트 절대 경로 — run.sh 가 같은 경로로 읽기 전용 마운트, docs/deploy.md 2-7).
# 비우면 task_data 볼륨 안 /data/images (적재·builder 가 호스트에서 쓴 묶음을 API 가 못 본다)
# IMAGES_DIR=/srv/task-spec/images

# SFTP 전달 (#116, docs/deploy.md 2-11) — 받는 곳마다 한 묶음. <이름> 은 DB delivery_target.name 과 같게 (소문자로 읽힘).
# 키·known_hosts 는 SFTP_DIR(권한 700) 아래 — run.sh 가 같은 경로로 읽기 전용 마운트. 비밀번호 인증은 쓰지 않는다
# SFTP_DIR=/etc/task-spec/sftp
# SFTP_TARGETS__GRADER_TEST__HOST=sftp.example.internal
# SFTP_TARGETS__GRADER_TEST__PORT=22
# SFTP_TARGETS__GRADER_TEST__USER=grader
# SFTP_TARGETS__GRADER_TEST__KEY_PATH=/etc/task-spec/sftp/grader_test_ed25519
# SFTP_TARGETS__GRADER_TEST__KNOWN_HOSTS=/etc/task-spec/sftp/known_hosts
# SFTP_TARGETS__GRADER_TEST__REMOTE_DIR=/upload
# SFTP_TIMEOUT_SECONDS=1800   # 역할 폴더 하나 보내는 시간 상한
# 받는 쪽이 가져가는 전달 (/pull, docs/deploy.md 2-12) — 받는 곳마다 토큰 하나(32자 이상). <이름> 은 DB delivery_target.name 과 같게
# PULL_TOKENS__GRADER_TEST=<openssl rand -hex 32 값>
