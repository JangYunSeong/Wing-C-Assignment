# task-builder 실행 설정 (docs/deploy.md 2-8). 복사해서 docker/builder/.env (권한 600, gitignore) 로.
# 컨테이너 안 경로·기본값(PROMPTS_DIR, INCIDENTS_DIR, TEMPLATES_DIR, CONTAINER_HOST)은 이미지에 들어 있다.
# 값에 따옴표를 쓰지 않는다 (podman --env-file 은 따옴표를 벗기지 않는다).

# DB — builder 전용 역할 (docker/builder/db-role.sql). 표 주인 task 계정은 run.sh 가 거부한다. 호스트 루프백 (--network host)
DATABASE_URL=postgresql://task_builder:<비밀번호>@127.0.0.1:5434/task_db

# LLM (API 와 같은 키)
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
# LLM_TIMEOUT_SECONDS=300

# 폴더 — 호스트와 같은 절대 경로로 붙는다 (run.sh). 미리 만들어 둔다 (docs/deploy.md 2-8)
BUILD_WORK_DIR=/srv/task-spec/builder/work
BUILD_TOOLS_DIR=/srv/task-spec/builder/tools
IMAGES_DIR=/srv/task-spec/images

# 묶음 권한 — API(다른 호스트 사용자)가 기본 ACL 로 읽게 그룹 읽기까지 (0600 이면 ACL 마스크가 비어 못 읽는다)
PACKAGE_FILE_MODE=640
PACKAGE_DIR_MODE=750

# 비용 상한 (qwen 기준 — 모델을 바꾸면 같이 올린다)
BUILD_BUDGET_USD=0.5
BUILD_DAILY_BUDGET_USD=5.0
# BUILD_LEASE_SECONDS=900
# BUILD_POLL_SECONDS=30
# BUILD_MAX_ATTEMPTS=2
# BUILD_DESIGNS=   (비우면 허용 설계 전부 — #171)
# BUILD_KEEP_FAILED_WORK=true
# 검증 컨테이너 상한 (#127)
# VERIFY_CPUS=2
# VERIFY_MEMORY=4g

# LOG_LEVEL=INFO
# LOG_FORMAT=json
